{
  "manifest_version": 3,
  "name": "IGOTOWATCHMOVIES",
  "version": "1.8.1",
  "description": "豆瓣电影/图书一键同步至飞书多维表格（支持TMDB封面、批量同步、智能去重）",
  "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "https://book.douban.com/*",
    "https://movie.douban.com/*",
    "https://*.doubanio.com/*",
    "https://open.feishu.cn/*",
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_1", "enabled": true, "path": "rules.json" }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://book.douban.com/subject/*", "https://movie.douban.com/subject/*", "https://movie.douban.com/top250*", "https://movie.douban.com/mine*", "https://movie.douban.com/people/*/collect*", "https://movie.douban.com/people/*/wish*", "https://movie.douban.com/people/*/do*", "https://movie.douban.com/chart*", "https://movie.douban.com/subject_collection/*", "https://movie.douban.com/annual/*", "https://book.douban.com/top250*", "https://book.douban.com/mine*", "https://book.douban.com/people/*/collect*", "https://book.douban.com/people/*/wish*", "https://book.douban.com/people/*/do*", "https://book.douban.com/subject_collection/*", "https://book.douban.com/explore*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}